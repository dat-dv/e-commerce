model UserAvatar {
      id            String    @id @default(cuid())

      user_id String
      user    User   @relation("UserAvatarHistory", fields: [user_id], references: [id], onDelete: Cascade)

      image_id String
      image    Image  @relation(fields: [image_id], references: [id])

      current_for_users User[] @relation("CurrentUserAvatar")

      created_at DateTime @default(now())

      @@unique([user_id, image_id])
      @@index([user_id])
      @@index([image_id])
      @@map("user_avatars")
}