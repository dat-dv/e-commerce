// prisma/schema/user.prisma

model User {
  id            String    @id @default(cuid())
  first_name    String?
  last_name     String?
  email         String    @unique
  password      String
  salt          String?
  date_of_birth DateTime?
  gender        Int?
  avatar_id     String?   @unique
  avatar        Image?    @relation(fields: [avatar_id], references: [id])
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  deleted_at    DateTime?

  refresh_tokens         RefreshToken[]
  shipping_addresses     ShippingAddress[]
  password_reset_tokens PasswordResetToken[]
  phones                UserPhone[]
  cart                  Cart?
  orders                Order[]
  browsing_history      UserBrowsingHistory[]
  reviews               Review[]
  notification_tokens   NotificationToken[]
  notifications         Notification[]
  favorite_categories   UserFavoriteCategory[]
  favorite_products     UserFavoriteProduct[]

  role_id String?
  role    Role?   @relation(fields: [role_id], references: [id])

  @@map("users")
}
