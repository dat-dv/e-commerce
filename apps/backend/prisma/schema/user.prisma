// prisma/schema/user.prisma

model User {
  id            String    @id @default(cuid())
  first_name    String?
  last_name     String?
  email         String    @unique
  password      String
  date_of_birth DateTime?
  gender        Int?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  deleted_at    DateTime?

  shipping_addresses       ShippingAddress[]
  password_reset_tokens    PasswordResetToken[]
  
  cart                     Cart?
  orders                   Order[]
  browsing_history         UserBrowsingHistory[]
  reviews                  Review[]
  notification_tokens      NotificationToken[]
  notifications            Notification[]
  favorite_categories      UserFavoriteCategory[]
  favorite_products        UserFavoriteProduct[]
  help_contact_submissions HelpContactSubmission[]
  order_returns            OrderReturn[]

  role_id String?
  role    Role?   @relation(fields: [role_id], references: [id])

  avatar_id String?
  avatar    UserAvatar? @relation("CurrentUserAvatar", fields: [avatar_id], references: [id], onDelete: SetNull)
  avatars   UserAvatar[]  @relation("UserAvatarHistory")

  active_phone_id String? @unique
  active_phone    UserPhone? @relation("ActivePhone", fields: [active_phone_id], references: [id], onDelete: SetNull)

  phones          UserPhone[] @relation("UserPhones")
  @@map("users")
}
