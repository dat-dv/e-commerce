// prisma/schema/schema.prisma

generator client {
  provider     = "prisma-client"
  output       = "../../generated/prisma"
  moduleFormat = "cjs"
}

generator shared {
  provider     = "prisma-client"
  output       = "../../../../packages/shared/src/generate"
  moduleFormat = "esm"
}

datasource db {
  provider = "sqlite"
}
