// prisma/schema/order.prisma

model Order {
  id                  String   @id @default(cuid())
  user_id             String
  status              Int      @default(300)
  total_amount        Float
  discount_amount     Float    @default(0)
  shipping_address_id String?
  coupon_id           String?
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  items          OrderItem[]
  return_request OrderReturn?
  user            User             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  shipping_address ShippingAddress? @relation(fields: [shipping_address_id], references: [id], onUpdate: NoAction, onDelete: SetNull)
  coupon          Coupon?          @relation(fields: [coupon_id], references: [id], onUpdate: NoAction, onDelete: SetNull)

  @@map("orders")
}

model OrderItem {
  id            String  @id @default(cuid())
  order_id      String
  sku_id        String
  flash_sale_id String? // ID của FlashSaleProduct nếu là hàng flash sale
  quantity      Int
  price         Float // Lưu giá lúc mua
  snapshot      Json?   // Snapshot dữ liệu sản phẩm tại thời điểm mua (JSON)

  order Order @relation(fields: [order_id], references: [id], onDelete: Cascade)
  sku   Sku   @relation(fields: [sku_id], references: [id])

  @@map("order_items")
}
