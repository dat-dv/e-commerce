// prisma/schema/product.prisma

// 1. TẦNG SẢN PHẨM (PRODUCT)
model Product {
  id         String    @id @default(cuid())
  slug       String   @unique
  seller_id  String? // Ai tạo sản phẩm này (Tạm thời để optional)
  brand_id   String?
  status     Int       @default(0) // 0: DRAFT, 1: ACTIVE, 2: OUT_OF_STOCK
  sold_count   Int       @default(0)
  review_count Int       @default(0)
  rating       Float     @default(0)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  base_price Float  @default(0) // Base price cho các trường hợp hiển thị tổng quan

  thumbnail_id String? @unique
  thumbnail    Image?  @relation(fields: [thumbnail_id], references: [id])

  brand Brand? @relation(fields: [brand_id], references: [id])

  translations ProductTranslation[]
  skus         Sku[]

  // Many-to-many với Category qua junction table
  categories ProductCategoryMapping[]

  // Relations from other tables that still reference Product
  view_history UserBrowsingHistory[]
  reviews      Review[]

  @@map("products")
}

// 2. TẦNG BIẾN THỂ & KHO HÀNG (SKU)
model Sku {
  id             String  @id @default(cuid())
  product_id     String
  sku_code       String  @unique
  price          Float
  original_price Float?
  stock          Int     @default(0)
  image_url      String?
  unit_price String? @default("VND")

  product              Product             @relation(fields: [product_id], references: [id], onDelete: Cascade)
  sku_attribute_values SkuAttributeValue[]

  // Relations from other tables
  cart_items  CartItem[]
  order_items OrderItem[]
  flash_sales FlashSaleProduct[]
  reviews     Review[]

  @@map("skus")
}
