// prisma/schema/product.prisma

// 1. Danh mục sản phẩm
model ProductCategory {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  image_id    String?   @unique
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  products    Product[]

  @@map("product_categories")
}

// 2. TẦNG SẢN PHẨM (PRODUCT)
model Product {
  id          String    @id @default(cuid())
  seller_id   String?   // Ai tạo sản phẩm này (Tạm thời để optional)
  category_id String?
  brand_id    String?
  status      String    @default("DRAFT") // DRAFT, ACTIVE, OUT_OF_STOCK
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?
  
  thumbnail_id String?   @unique
  thumbnail    Image?    @relation(fields: [thumbnail_id], references: [id])

  translations ProductTranslation[]
  skus         Sku[]
  
  category    ProductCategory? @relation(fields: [category_id], references: [id])
  
  // Relations from other tables that still reference Product
  view_history     UserBrowsingHistory[]
  reviews          Review[]
}

// 3. TẦNG BIẾN THỂ & KHO HÀNG (SKU)
model Sku {
  id         String   @id @default(cuid())
  product_id String
  sku_code   String   @unique
  price      Float
  stock      Int      @default(0)
  image_url  String?
  
  product    Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  sku_attribute_values SkuAttributeValue[]
  
  // Relations from other tables
  cart_items       CartItem[]
  order_items      OrderItem[]
  flash_sales      FlashSaleProduct[]
  reviews          Review[]
}

// 4. Chiến dịch Flash Sale
model FlashSale {
  id          String    @id @default(cuid())
  name        String
  start_time  DateTime
  end_time    DateTime
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  products    FlashSaleProduct[]
}

model FlashSaleProduct {
  id             String    @id @default(cuid())
  flash_sale_id  String
  sku_id         String
  sale_price     Float     
  stock          Int       
  sold_count     Int       @default(0)

  flash_sale     FlashSale @relation(fields: [flash_sale_id], references: [id], onDelete: Cascade)
  sku            Sku       @relation(fields: [sku_id], references: [id], onDelete: Cascade)

  @@unique([flash_sale_id, sku_id])
}
