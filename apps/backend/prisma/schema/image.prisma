// prisma/schema/image.prisma

model Image {
  id         String   @id @default(cuid())
  url        String
  public_id  String
  width      Int?
  height     Int?
  format     String?
  bytes      Int?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user_avatars UserAvatar[]
  product  Product?
  category ProductCategory?
  brand_logo   Brand? @relation("BrandLogo")
  brand_banner Brand? @relation("BrandBanner")
  help_contact_submission_images HelpContactSubmissionImage[]
  order_return_images            OrderReturnImage[]

  @@map("images")
}
