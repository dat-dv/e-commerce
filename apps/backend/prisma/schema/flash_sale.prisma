// prisma/schema/flash_sale.prisma

model FlashSaleTimeSlot {
  id           String  @id @default(cuid())
  name         String // Ví dụ: "Khung giờ sáng", "Sale Đêm"
  start_hour   Int // 0-23
  start_minute Int     @default(0)
  end_hour     Int // 0-23
  end_minute   Int     @default(59)
  is_active    Boolean @default(true)

  flash_sales FlashSale[]

  @@map("flash_sale_time_slots")
}

model FlashSale {
  id         String   @id @default(cuid())
  name       String
  start_time DateTime
  end_time   DateTime
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  time_slot_id String?
  time_slot    FlashSaleTimeSlot? @relation(fields: [time_slot_id], references: [id])

  products FlashSaleProduct[]

  @@map("flash_sales")
}

model FlashSaleProduct {
  id            String @id @default(cuid())
  flash_sale_id String
  sku_id        String
  sale_price    Float
  stock         Int
  sold_count    Int    @default(0)
  order_limit   Int    @default(1) // Giới hạn mua mỗi khách

  flash_sale FlashSale @relation(fields: [flash_sale_id], references: [id], onDelete: Cascade)
  sku        Sku       @relation(fields: [sku_id], references: [id], onDelete: Cascade)

  @@unique([flash_sale_id, sku_id])
  @@map("flash_sale_products")
}
