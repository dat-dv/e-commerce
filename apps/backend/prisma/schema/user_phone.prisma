// prisma/schema/user_phone.prisma

model UserPhone {
  id          String   @id @default(cuid())
  phone       String
  phone_code  String
  is_verified Boolean  @default(false)

  user_id     String
  user        User     @relation("UserPhones", fields: [user_id], references: [id], onDelete: Cascade)

  active_user User? @relation("ActivePhone")
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@unique([user_id, phone])
  @@index([user_id])
  @@map("user_phones")
}
