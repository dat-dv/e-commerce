model Brand {
  id             String   @id @default(cuid())
  slug           String   @unique
  logo_id        String?  @unique
  logo           Image?   @relation("BrandLogo", fields: [logo_id], references: [id])
  banner_id      String?  @unique
  banner         Image?   @relation("BrandBanner", fields: [banner_id], references: [id])
  logo_url       String?  // fallback or legacy
  banner_url     String?  // fallback or legacy
  website_url    String?
  founded_year   Int?
  headquarters   String?
  is_verified    Boolean  @default(false)
  is_featured    Boolean  @default(false) // dùng cho Top Brands section
  order          Int      @default(0) // thứ tự hiển thị trong Top Brands
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  translations BrandTranslation[]
  products     Product[]

  @@map("brands")
}

model BrandTranslation {
  id          String @id @default(cuid())
  brand_id    String
  language_id String
  name        String
  description String?
  story       String?

  brand    Brand    @relation(fields: [brand_id], references: [id], onDelete: Cascade)
  language Language @relation(fields: [language_id], references: [id])

  @@unique([brand_id, language_id])
  @@map("brand_translations")
}
