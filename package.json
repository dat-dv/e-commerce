{
  "name": "e-commerce-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "man": "node scripts/man.js",
    "predev": "npm run build -w @ecommerce/shared",
    "dev:be": "npm run start:dev -w apps/backend",
    "build:be": "npm run build -w apps/backend",
    "test:be": "npm run test -w apps/backend",
    "lint:be": "npm run lint -w apps/backend",
    "format:be": "npm run format -w apps/backend",
    "dev:fe": "npm run dev -w apps/frontend",
    "build:fe": "npm run build -w apps/frontend",
    "lint:fe": "npm run lint -w apps/frontend",
    "dev:be:shared": "concurrently \"npm run dev:be\" \"npm run dev:shared\"",
    "dev:fe:shared": "concurrently \"npm run dev:fe\" \"npm run dev:shared\"",
    "dev:shared": "npm run dev -w packages/shared",
    "dev": "concurrently \"npm run dev:be\" \"npm run dev:fe\" \"npm run dev:shared\"",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces",
    "type-check": "npm run type-check -w apps/frontend",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "^3.0.0"
  }
}
