{
  "name": "e-commerce-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "man": "node scripts/man.js",
    "predev": "npm run build -w @ecommerce/shared",
    "dev:be": "npm run dev -w apps/backend",
    "build:be": "npm run build -w apps/backend",
    "test:be": "npm run test -w apps/backend",
    "lint:be": "npm run lint -w apps/backend",
    "format:be": "npm run format -w apps/backend",
    "dev:fe": "npm run dev -w apps/frontend",
    "build:fe": "npm run build -w apps/frontend",
    "lint:fe": "npm run lint -w apps/frontend",
    "dev:be:shared": "npm run dev:be",
    "dev:fe:shared": "npm run dev:fe",
    "dev:shared": "npm run dev -w packages/shared",
    "dev": "concurrently \"npm run start:dev -w apps/backend\" \"npm run dev:next -w apps/frontend\" \"npm run dev:shared\"",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces",
    "type-check": "npm run type-check -w apps/frontend",
    "db:reset": "npm run db:reset -w apps/backend",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "prettier": "^3.0.0"
  },
  "lint-staged": {
    "apps/frontend/**/*.{js,jsx,ts,tsx}": [
      "eslint --fix --config apps/frontend/eslint.config.mjs"
    ],
    "apps/backend/**/*.ts": [
      "eslint --fix --config apps/backend/eslint.config.mjs"
    ]
  }
}
