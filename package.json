{
  "name": "e-commerce-monorepo",
  "private": true,
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "man": "node scripts/man.js",
    "dev": "turbo run build --filter=@ecommerce/shared --filter=@ecommerce/ui && turbo run dev",
    "dev:fe": "turbo run build --filter=@ecommerce/shared --filter=@ecommerce/ui && turbo run dev --filter=@ecommerce/shared --filter=@ecommerce/ui --filter=frontend",
    "dev:be": "turbo run build --filter=@ecommerce/shared && turbo run dev --filter=@ecommerce/shared --filter=e-commerce",
    "debug:be": "turbo run build --filter=@ecommerce/shared && turbo run debug --filter=e-commerce",
    "i18n:gen": "turbo run i18n:gen --filter=frontend",
    "build:shared": "turbo run build --filter=@ecommerce/shared",
    "build:be": "turbo run build --filter=e-commerce",
    "build:ui": "turbo run build --filter=@ecommerce/ui",
    "test:be": "turbo run test --filter=e-commerce",
    "lint:be": "turbo run lint --filter=e-commerce",
    "format:be": "turbo run format --filter=e-commerce",
    "build:fe": "turbo run build --filter=frontend",
    "lint:fe": "turbo run lint --filter=frontend",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "db:reset": "turbo run db:reset --filter=e-commerce",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "nodemon": "^3.1.14",
    "prettier": "^3.0.0",
    "turbo": "^2.9.16"
  },
  "lint-staged": {
    "apps/frontend/**/*.{js,jsx,ts,tsx}": [
      "eslint --fix --config apps/frontend/eslint.config.mjs"
    ],
    "apps/backend/**/*.ts": [
      "eslint --fix --config apps/backend/eslint.config.mjs"
    ]
  }
}
