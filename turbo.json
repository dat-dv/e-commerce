{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"]
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "outputs": ["coverage/**"]
    },
    "type-check": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "format": {
      "outputs": []
    },
    "db:reset": {
      "cache": false,
      "outputs": []
    },
    "i18n:gen": {
      "outputs": ["messages/en.json", "messages/vi.json"]
    },
    "i18n:watch": {
      "cache": false,
      "persistent": true
    },
    "debug": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@ecommerce/frontend#dev": {
      "cache": false,
      "persistent": true,
      "with": ["@ecommerce/frontend#i18n:watch"]
    },
    "start": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}
