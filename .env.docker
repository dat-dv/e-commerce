# ============================================================
# .env.docker — Docker production environment template
# Copy this file to .env and replace all placeholder values
# ============================================================

# ── Backend ──────────────────────────────────────────────
PORT=3000

# JWT Secrets — MUST be replaced with secure random strings
ACCESS_TOKEN_SECRET=change_me_access_token_secret_at_least_32_chars
ACCESS_TOKEN_EXPIRES_IN=900

REFRESH_TOKEN_SECRET=change_me_refresh_token_secret_at_least_32_chars
REFRESH_TOKEN_EXPIRES_IN=604800

RESET_PASSWORD_TOKEN_SECRET=change_me_reset_password_secret_at_least_32_chars
RESET_PASSWORD_TOKEN_EXPIRES_IN=900

# Frontend URL (used for CORS)
FE_URL=https://datintech.site

# Google SMTP
GOOGLE_SMTP_USER=your_gmail@gmail.com
GOOGLE_SMTP_PASS=your_google_app_password

# Firebase Admin SDK
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email

# IMPORTANT:
# Private key must stay wrapped in double quotes
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Frontend (embedded into Next.js during build) ─────────
NEXT_PUBLIC_API_URL=https://api.datintech.site/api
NEXT_PUBLIC_SITE_URL=https://datintech.site

NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_firebase_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your_vapid_key